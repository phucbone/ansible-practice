[Unit]
Description=Elasticsearch 7.10.1
Documentation=http://www.elastic.co
Wants=network.target
After=network.target

[Service]
ExecStart="{{ es_download_path }}"/current/bin/elasticsearch
Restart=always
User="{{ es_user }}"
Group="{{ es_group }}"
LimitMEMLOCK=infinity
LimitNPROC=4096
LimitNOFILE=65536
TimeoutStartSec=75

[Install]
WantedBy=multi-user.target
